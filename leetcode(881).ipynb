   ],
   "source": [
    "people = [5,1,4,2]\n",
    "limit = 6\n",
    "people.sort()\n",
    "print(people,len(people))\n",
    "i = 0\n",
    "j = len(people)-1\n",
    "boats = 0\n",
    "while i<j:\n",
    "    if people[i] + people[j]<=limit:\n",
    "        i+=1\n",
    "        boats+=1\n",
    "    j-=1\n",
    "    \n",
    "    \n",
    "print(f'boats:{boats}\\ni,j:{i,j}')\n",
    "print(len(people) - boats)"
   ]
  },
