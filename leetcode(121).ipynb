     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "min_value = float('inf')\n",
    "max_profit = 0\n",
    "for price in prices:\n",
    "    if price < min_value:\n",
    "        min_value = price\n",
    "    else:\n",
    "        max_profit = max(max_profit,price-min_value)\n",
    "\n",
    "max_profit\n"
   ]
  },
